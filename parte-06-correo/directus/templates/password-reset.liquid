{% layout "codegea-base" %}

{% block header %}Restablece tu contraseña{% endblock %}

{% block content %}
  <p>Recibimos una solicitud para cambiar
     tu contraseña de {{ projectName }}.</p>
  <p>Si no fuiste tú, ignora este correo.</p>
  <p>Si fuiste tú, usa el botón:</p>
  <a class="btn" href="{{ url }}">Cambiar mi contraseña</a>
  <p>El enlace vence en 24 horas.</p>
{% endblock %}
